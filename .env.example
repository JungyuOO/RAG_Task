CLLM_BASE_URL=
CLLM_MODEL=

RAG_DATA_DIR=/app/data
RAG_SOURCE_DIR=/app/data/corpus/pdfs
RAG_INDEX_DIR=/app/data/index
RAG_CACHE_DIR=/app/data/cache
RAG_EXTRACT_DIR=/app/data/extracted_markdown

# 임베딩 모델: "hash" (기본, 오프라인), "e5" (multilingual-e5-small), "bge" (BGE-M3 via Ollama)
EMBEDDING_MODEL=bge

# Ollama 설정
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_RERANKER_MODEL=bge-reranker-v2-m3

# RRF 검색 활성화
USE_RRF=true
RRF_K=60

# 리랭킹 활성화
USE_RERANKER=false
RERANKER_TOP_K=5
RERANKER_CANDIDATE_K=20

# PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
